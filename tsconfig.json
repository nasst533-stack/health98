{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ES2020",
    "jsx": "react",
    "allowJs": true,
    "outDir": "dist",
    "rootDir": "src",
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmitOnError": false,
    "checkJs": false
  },
  "include": ["src/**/*"]
}
